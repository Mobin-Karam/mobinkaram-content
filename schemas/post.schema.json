{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mobin-Karam/mobinkaram-content/schemas/post.schema.json",
  "title": "MobinKaram blog post frontmatter",
  "type": "object",
  "required": [
    "title",
    "description",
    "date",
    "slug",
    "tags",
    "category",
    "readingTime",
    "published",
    "author"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": { "type": "string", "minLength": 1 },
    "translationKey": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "category": { "type": "string", "minLength": 1 },
    "cover": { "type": "string" },
    "readingTime": { "type": "integer", "minimum": 1 },
    "published": { "type": "boolean" },
    "author": { "type": "string", "minLength": 1 },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": true
}
